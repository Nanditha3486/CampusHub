{
  "name": "campushub-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "CampusHub - AI-Powered Student Community Platform",
  "scripts": {
    "setup": "cd server && npm install && cd ../client && npm install",
    "dev": "concurrently -n \"server,client\" -c \"blue,cyan\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "seed": "cd server && npm run seed",
    "test": "cd server && npm test",
    "build": "cd client && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
